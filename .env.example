# Bind to 127.0.0.1 for local-only access. Set the host management IP for remote Checkmk.
NOTIFY_BIND_IP=127.0.0.1
NOTIFY_PORT=8788

# Existing SignalClient Compose network and API container.
SIGNAL_DOCKER_NETWORK=signal-api-network
SIGNAL_API_URL=http://signal-api:8080

# Fill these with the registered Signal sender and recipient phone number(s).
SIGNAL_NUMBER=+491234567890
SIGNAL_RECIPIENTS=+491234567890

# Replace with at least 32 random characters (for example: openssl rand -hex 32).
NOTIFY_TOKEN=CHANGE_ME
